#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

echo "Running fast test profile (all tests except the slow convex-hull suite)."
bash "$root/scripts/check-readme-recipes"
dotnet test "$root/tests/SvgPath.Tests/SvgPath.Tests.fsproj" --filter "Category!=Slow"
